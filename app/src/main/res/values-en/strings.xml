    <string name="auto_books_guide">How auto-add works</string>
    <string name="guide_intro">Only what the e-book app shows on its shelf and reading screens is read. Anything the screen does not show is not updated.</string>
    <string name="guide_apps">Supported apps</string>
    <string name="guide_limits">Apps with limits</string>
    <string name="guide_kel">Kyobo Library</string>
    <string name="guide_kel_desc">In cover view, open the menu while reading to add the book.</string>
    <string name="guide_kyobo">Kyobo eBook (e-ink)</string>
    <string name="guide_kyobo_mobile">Kyobo eBook</string>
    <string name="guide_kyobo_desc">Open the menu while reading to add the book. The cover stays blank.</string>
    <string name="guide_millie">Millie (e-ink)</string>
    <string name="guide_millie_mobile">Millie</string>
    <string name="guide_aladin">Aladin</string>
    <string name="guide_aladin_desc">Books opened from grid view or by resuming are added when you open the menu while reading.\nA resumed book may have a blank cover until you go back to the shelf.</string>
    <string name="guide_bookers">Bookers</string>
    <string name="guide_ridi">Ridi</string>
    <string name="guide_ridi_onestore">Ridi (ONE store)</string>
    <string name="guide_ridi_desc">Open the menu while reading to add the book.\nOpened without the shelf, the cover may be blank.</string>
    <string name="guide_yes24lib">YES24 Library (e-ink)</string>
    <string name="guide_yes24lib_mobile">YES24 Library</string>
    <string name="guide_myyes">my YES</string>
    <string name="guide_myyes_desc">Covers cannot be taken, so they stay blank.</string>
    <string name="guide_yes24ebook">YES24 eBook</string>
    <string name="guide_moon">Moon+ Reader</string>
    <string name="guide_moon_pro">Moon+ Reader Pro</string>
    <string name="guide_moon_desc">Opened from a cover in the Home tab\'s recent row, open the menu while reading to add the book.</string>
    <string name="guide_kindle">Kindle</string>
    <string name="guide_kindle_desc">Books not yet downloaded, and progress while reading, come in only when you open the menu.\nThe grid library can\'t give covers of books you have read; open the list view once.</string>
    <string name="guide_libby">Libby</string>
    <string name="guide_libby_desc">Progress while reading comes in only when you open the menu. Covers come from the Shelf screen.\nReading time is counted only while auto-add is on.</string>
    <string name="guide_neo">NeoReader (BOOX)</string>
    <string name="guide_neo_desc">Covers are blank (EPUB covers come in when Read book files is on).\nTapping the book on the home screen opens its file in NeoReader.</string>
    <string name="guide_ko">KOReader</string>
    <string name="guide_ko_desc">Books come in only when Settings › Reading › Read book files is on. Books opened in KOReader come in when you return home.\nTapping the book on the home screen opens its file directly.</string>
    <string name="book_files">Read book files</string>
    <string name="book_files_desc">KOReader doesn\'t show book titles on screen, so the book you open and your progress are read from the records KOReader keeps (the koreader folder and the .sdr folder next to each book). Only the title, author and cover are taken from book files.\n\nAllow Pebble Desk in Android\'s All files access. Nothing leaves the device.</string>
    <string name="open_file_access">Open All files access</string>
    <string name="app_neoreader">NeoReader (BOOX)</string>
    <string name="guide_progress_note">For progress while reading, turn on the bottom info (page or progress) in the e-book app\'s viewer settings.</string>
    <string name="guide_cover_note">Covers are cut from the shelf screen. If a title or author is cut off, wrong or missing, long-press the book on the home screen to fix it.</string>
    <string name="edit_title">Edit title</string>
    <string name="add_author">Add author</string>
    <string name="edit_author">Edit author</string>
    <string name="save">Save</string>
    <string name="reader_watch_desc">Reads only book titles, authors, progress, due dates and covers on the shelf and search screens, and the title and progress on the reading screen, of Kyobo Library, Kyobo eBook, Millie, Aladin, Bookers, Ridi, YES24 (Library, my YES, eBook), Moon+ Reader, Kindle, Libby, NeoReader and KOReader to fill your reading list. Book text and other apps are not seen, and nothing leaves the device.</string>
