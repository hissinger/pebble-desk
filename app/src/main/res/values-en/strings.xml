    <string name="guide_aladin">Aladin</string>
    <string name="guide_aladin_desc">In grid view, open the menu while reading to add the book.\nOpened without the shelf, the cover may be blank.</string>
    <string name="guide_bookers">Bookers</string>
    <string name="guide_ridi">Ridi</string>
    <string name="guide_ridi_desc">Open the menu while reading to add the book.\nOpened without the shelf, the cover may be blank.</string>
    <string name="guide_yes24lib">YES24 Library</string>
    <string name="guide_myyes">my YES</string>
    <string name="guide_myyes_desc">Covers cannot be taken, so they stay blank.</string>
    <string name="guide_yes24ebook">YES24 eBook</string>
    <string name="guide_moon">Moon+ Reader</string>
    <string name="guide_moon_desc">Opened from a cover in the Home tab\'s recent row, open the menu while reading to add the book.</string>
    <string name="guide_progress_note">For progress while reading, turn on the bottom info (page or progress) in the e-book app\'s viewer settings.</string>
    <string name="guide_cover_note">Covers are cut from the shelf screen. If a title or author is cut off, wrong or missing, long-press the book on the home screen to fix it.</string>
