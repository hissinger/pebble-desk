<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 런처라서 설치된 앱 전체와 크레마 런처(로고)를 봐야 한다. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 지금 읽는 책: YES24 에서 책 표지 검색 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 상태 줄: 와이파이·블루투스가 켜져 있는지 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- 오늘 읽은 시간: 이북 앱의 읽는 화면이 떠 있던 시간(사용자가 '사용 기록 액세스'에서 허용해야 한다) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PebbleDesk">

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- 기본 홈으로 정하기 전에도 기존 런처에서 열어 볼 수 있게 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppListActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".FavoritesActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".BooksActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".BookSearchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ReadingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SettingsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>
</manifest>
