<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 런처라서 설치된 앱 전체와 크레마 런처(로고)를 봐야 한다. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 지금 읽는 책: 책 표지 검색(YES24·Apple Books·Open Library) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 설정 › 업데이트: 인터넷에 연결돼 있는지. 상태 줄: 와이파이에 연결돼 있는지 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 기기 정보: 와이파이가 켜져 있는지 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 상태 줄: 블루투스가 켜져 있는지·연결된 기기(12+ 는 '근처 기기' 권한이 필요해 연결은 모른다) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- 설정 › 업데이트: GitHub 에서 받은 새 판을 설치 창으로 깐다(사용자가 '출처를 알 수 없는 앱 설치'를 허용해야 한다) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 오늘 읽은 시간: 이북 앱의 읽는 화면이 떠 있던 시간(사용자가 '사용 기록 액세스'에서 허용해야 한다) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 읽는 책 자동 추가(KOReader): KOReader 가 저장소에 남기는 기록(koreader/history.lua, 책 옆 .sdr)과 책 파일(제목·표지)을 읽는다.
         안드로이드 11+ 은 '모든 파일 액세스'(사용자가 설정 › 독서에서 허용), 10 까지는 저장소 읽기 권한(10 은 예전 저장소 방식으로) -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:name=".PebbleDeskApp"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PebbleDesk">

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- 기본 홈으로 정하기 전에도 기존 런처에서 열어 볼 수 있게 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 하위 화면은 연 때의 회전 그대로(locked) 열고, 기기 정보의 회전 고정 시험을 켜지 않았으면 EinkActivity.onCreate 가 바로 풀어
             시스템이 방향을 정하게 한다(홈은 정하지 않는다). 연 뒤에 잠그면 시스템이 이미 회전을 정한 뒤라 시험이 되지 않는다. -->
        <activity
            android:name=".AppListActivity"
            android:screenOrientation="locked"
            android:excludeFromRecents="true"
            android:exported="false" />

        <activity
            android:name=".FavoritesActivity"
            android:screenOrientation="locked"
            android:excludeFromRecents="true"
            android:exported="false" />

        <activity
            android:name=".BooksActivity"
            android:screenOrientation="locked"
            android:excludeFromRecents="true"
            android:exported="false" />

        <activity
            android:name=".BookSearchActivity"
            android:screenOrientation="locked"
            android:excludeFromRecents="true"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".IconPickActivity"
            android:screenOrientation="locked"
            android:excludeFromRecents="true"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ReadingActivity"
            android:screenOrientation="locked"
            android:excludeFromRecents="true"
            android:exported="false" />

        <activity
            android:name=".YearBooksActivity"
            android:screenOrientation="locked"
            android:excludeFromRecents="true"
            android:exported="false" />

        <activity
            android:name=".RecapActivity"
            android:screenOrientation="locked"
            android:excludeFromRecents="true"
            android:exported="false" />

        <activity
            android:name=".OnboardingActivity"
            android:screenOrientation="locked"
            android:excludeFromRecents="true"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:screenOrientation="locked"
            android:excludeFromRecents="true"
            android:exported="false" />

        <activity
            android:name=".DeviceInfoActivity"
            android:screenOrientation="locked"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name=".WatchLogActivity"
            android:screenOrientation="locked"
            android:excludeFromRecents="true"
            android:exported="false" />

        <!-- 설정 › 업데이트: 설치 세션 결과(사용자 확인이 필요하면 설치 창을 띄운다) -->
        <receiver
            android:name=".Update$StatusReceiver"
            android:exported="false" />
        <!-- 새 판이 깔리면 홈을 다시 띄운다(설정에서 맡긴 설치일 때) -->
        <receiver
            android:name=".Update$ReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 읽는 책 자동 추가(설정 > 독서). 사용자가 안드로이드 접근성에서 켜야 동작한다. -->
        <service
            android:name=".ReaderWatchService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/reader_watch" />
        </service>
        <!-- 월간 결산 그림을 다른 앱에 보낼 때만 읽기로 내준다(RecapActivity) -->
        <provider
            android:name=".RecapFiles"
            android:authorities="${applicationId}.recap"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
